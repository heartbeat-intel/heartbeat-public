---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  theme?: 'dark' | 'light';
}

const SITE_ORIGIN = 'https://www.heartbeatintel.com';
const DEFAULT_OG_IMAGE = '/images/social/heartbeat-preview-v1.png';

const props: Props = Astro.props;
const {
  title,
  description = 'Trade in intelligence, not just information. Connect with publishers who curate and monetize exclusive intel.',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'Heartbeat Intelligence — Designed to traffic in intelligence.',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  theme = 'light',
} = props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_ORIGIN).toString();
const ogImageUrl = new URL(ogImage, SITE_ORIGIN).toString();
const imagePath = new URL(ogImageUrl).pathname.toLowerCase();
const ogImageType = imagePath.endsWith('.png')
  ? 'image/png'
  : imagePath.match(/\.jpe?g$/)
    ? 'image/jpeg'
    : imagePath.endsWith('.webp')
      ? 'image/webp'
      : undefined;
const ogImageWidth = props.ogImageWidth ?? (ogImage === DEFAULT_OG_IMAGE ? 1200 : undefined);
const ogImageHeight = props.ogImageHeight ?? (ogImage === DEFAULT_OG_IMAGE ? 630 : undefined);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth.toString()} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight.toString()} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Heartbeat Intelligence" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/logos/heartbeatLogoBlack.svg" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DYXQ5WQC47"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DYXQ5WQC47');
    </script>

    <!-- Preconnect for external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.iconify.design" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('hb-theme');
        var theme = stored === 'dark' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--hb-bg-primary)] text-[var(--hb-text-primary)]">
    <div class="noise-overlay"></div>
    <slot />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/theme.ts"></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
